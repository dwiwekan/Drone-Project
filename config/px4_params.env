# PX4 parameter overrides for SITL, applied on every launch by scripts/sim_up.sh.
#
# Format: PARAM_NAME=VALUE, one per line. Each entry is exported as the env var
# PX4_PARAM_<PARAM_NAME>, which PX4's SITL startup script applies at boot
# (see PX4-Autopilot/ROMFS/px4fmu_common/init.d-posix/rcS). This keeps all
# project-specific settings in this repo instead of modifying PX4 itself.

# Allow arming without a ground control station (e.g. QGroundControl) connected.
# PX4's default (2 = Return mode on datalink loss) refuses to arm when no GCS is
# present, and a ROS 2 / uXRCE-DDS connection does not count as a GCS.
# Simulation only: real vehicles should keep a datalink-loss failsafe enabled.
NAV_DLL_ACT=0
